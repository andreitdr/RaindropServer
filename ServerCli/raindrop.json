{
  "urls": [ "https://localhost:5001" ],

  "tls": {
    "enabled": true,
    "certificatePath": "raindrop.pfx",
    "certificatePassword": null,
    "hostNames": null,
    // Signs the certificate's fingerprint so clients can follow a certificate
    // change. Generated on first start; back it up with raindrop.pfx.
    "identityKeyPath": "server-identity.key",
    "allowTls12": false
  },

  "database": {
    "provider": "sqlite",
    "connectionString": "Data Source=raindrop.db",
    "autoCreateSchema": true
  },

  "users": {
    "dataRetentionDays": 730,
    "sessionIdleTimeoutHours": 12,
    "minimumPasswordLength": 8
  },

  // Messages are end-to-end encrypted; the server stores ciphertext it cannot
  // read. Allow plaintext posts only for clients that cannot encrypt yet.
  "channels": {
    "maximumMessageLength": 4000,
    "defaultHistoryPageSize": 50,
    "maximumHistoryPageSize": 200,
    "allowPlaintextMessages": false
  },

  // What a fresh server starts with. The everyone role is seeded from
  // defaultMemberPermissions the first time the server runs; after that it is
  // edited through the API, and changing this setting leaves it alone.
  "roles": {
    "defaultMemberPermissions": [ "view_channel", "send_messages", "create_channels", "connect", "speak" ],
    "channelCreatorModeratesOwnChannels": true,
    "firstMemberBecomesOwner": true
  },

  // Voice calls need a media server to carry the audio. Set "provider" to
  // "livekit" and point "livekit" at one to switch them on; with null, voice
  // channels can be created but nobody can join them. Clients never reach
  // LiveKit's apiUrl themselves — they connect through this server — so only
  // LiveKit's media ports (UDP 7882, TCP 7881) need to be reachable from outside.
  // Set the key and secret through RAINDROP_LIVEKIT_API_KEY and
  // RAINDROP_LIVEKIT_API_SECRET, with the same values LiveKit has (.env). The
  // secret must be 32+ random characters; LiveKit's --dev "secret" is refused.
  "voice": {
    "provider": null,
    "maximumParticipants": 25,
    "livekit": {
      "apiUrl": "http://localhost:7880",
      "apiKey": null,
      "apiSecret": null,
      "allowWeakSecret": false
    }
  }
}
