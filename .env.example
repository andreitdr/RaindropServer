# Copy this file to .env and fill in real passwords before running `docker compose up`.
# .env is gitignored — never commit real credentials.

POSTGRES_USER=raindrop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=raindrop
POSTGRES_PORT=5432

# SQL Server's own complexity rule: 8+ characters, with at least three of
# uppercase / lowercase / digit / symbol.
MSSQL_SA_PASSWORD=Change-Me-123
MSSQL_PORT=1433

# The address LiveKit advertises for audio: 127.0.0.1 when every client runs on
# this machine, this machine's LAN address (e.g. 192.168.1.20) when other
# devices join calls.
LIVEKIT_NODE_IP=127.0.0.1

# The key pair Raindrop signs LiveKit tokens with. LiveKit and Raindrop must be
# given the same values (RAINDROP_LIVEKIT_API_KEY / RAINDROP_LIVEKIT_API_SECRET
# for the server). The secret must be at least 32 random characters — generate
# one with: openssl rand -base64 48
LIVEKIT_API_KEY=raindrop
LIVEKIT_API_SECRET=

# The port the "server" service publishes on the host. Only needed if 5001 is
# already taken by something else.
RAINDROP_PORT=5001

# DEVELOPMENT ONLY. Set to true to drop every table each time the "server"
# service starts, so you always begin from an empty database. No confirmation,
# no undo — leave this false (or unset) anywhere the data matters.
RAINDROP_DEV_WIPE_DATABASE=false
